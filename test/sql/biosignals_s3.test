# name: test/sql/biosignals_s3.test
# description: test S3 compatibility for the biosignals extension
# group: [sql]

require-env RUN_LOCAL_S3_TESTS

require biosignals

require httpfs

statement ok
CREATE SECRET garage_secret (
    TYPE s3,
    PROVIDER config,
	ENDPOINT 'localhost:3900',
    KEY_ID 'GARAGEADMINACCESSKEY',
    SECRET 'garagetestingsecretkey',
	REGION 'garage',
	USE_SSL false,
	URL_STYLE 'path'
);


# ========================================== read_edf_global_header ==========================================

statement ok
FROM read_edf_global_header('s3://biosignals-test/test_data/**');

query I
SELECT COUNT(*) FROM read_edf_global_header('s3://biosignals-test/test_data/**');
----
8

query I
SELECT COUNT(*) FROM read_edf_global_header('s3://biosignals-test/test_data/*.edf');
----
6

query I
SELECT COUNT(*) FROM read_edf_global_header('s3://biosignals-test/test_data/*.bdf');
----
2


# ========================================== read_edf_signal_headers ==========================================

statement ok
FROM read_edf_signal_headers('s3://biosignals-test/test_data/**');

query I
SELECT COUNT(*) FROM read_edf_signal_headers('s3://biosignals-test/test_data/**');
----
71

query I
SELECT COUNT(*) FROM read_edf_signal_headers('s3://biosignals-test/test_data/*.edf');
----
42

query I
SELECT COUNT(*) FROM read_edf_signal_headers('s3://biosignals-test/test_data/*.bdf');
----
29


# ========================================== read_edf_signal ==========================================

query IIIIIII
FROM read_edf_signal('s3://biosignals-test/test_data/*Hypnogram.edf');
----

statement ok
FROM read_edf_signal('s3://biosignals-test/test_data/*.edf');

statement ok
FROM read_edf_signal('s3://biosignals-test/test_data/*.bdf');

statement ok
FROM read_edf_signal('s3://biosignals-test/test_data/*');

query I
