# read a discontinuous file
query I
SELECT
	COUNT(s.time != a.onset)
FROM read_edf_signal('test/test_data/edf_plusD_example.edf') s
LEFT JOIN (
	FROM read_edf_annotations('test/test_data/edf_plusD_example.edf')
	WHERE annotations IS NULL
) a ON s.record_id = a.record_id
WHERE s.signal_id = 1 AND s.timestep % 200 = 0;
----
11

